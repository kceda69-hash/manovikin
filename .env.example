# --- Sovereign AI provider (OpenAI-compatible endpoint) ---
# Examples:
#   Ollama:     MANOVIK_AI_BASE_URL=http://ollama:11434/v1   MANOVIK_AI_API_KEY=ollama   MANOVIK_AI_MODEL=llama3.1
#   vLLM:       MANOVIK_AI_BASE_URL=http://vllm:8000/v1      MANOVIK_AI_API_KEY=any      MANOVIK_AI_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   OpenAI:     MANOVIK_AI_BASE_URL=https://api.openai.com/v1 MANOVIK_AI_API_KEY=sk-...   MANOVIK_AI_MODEL=gpt-4o-mini
#   OpenRouter: MANOVIK_AI_BASE_URL=https://openrouter.ai/api/v1 MANOVIK_AI_API_KEY=sk-or-... MANOVIK_AI_MODEL=anthropic/claude-3.5-sonnet
MANOVIK_AI_BASE_URL=http://ollama:11434/v1
MANOVIK_AI_API_KEY=ollama
MANOVIK_AI_MODEL=llama3.1

# --- Postgres ---
# REQUIRED: set a strong, unique value (URL-safe characters only — it is
# embedded in database connection URLs). Compose will refuse to start if empty.
POSTGRES_PASSWORD=

# --- Self-hosted Supabase: signing keys ---
# Generate once with:
#   ./scripts/gen-supabase-keys.sh >> .env
# (reuses JWT_SECRET from the environment if it is already set).
# The anon (publishable) key is public by design — it ships in the JS bundle.
# The service_role key bypasses all row-level security: NEVER expose it to
# browsers; it is only used by server-side code.
JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Self-hosted Supabase: URLs (optional overrides) ---
# Defaults need no changes for a single-machine setup:
#   - server-side app code  -> http://kong:8000   (internal Docker network)
#   - browser (VITE_*)      -> http://localhost:8000 (must resolve in the browser)
# Uncomment to point the app at Supabase Cloud (or a LAN / reverse-proxy
# address) instead of the bundled services. After changing VITE_* values,
# rebuild the app image:  docker compose up -d --build manovik
#SUPABASE_URL=https://xyzcompany.supabase.co
#VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Public base URL of the Supabase API gateway (used in auth email links).
SUPABASE_PUBLIC_URL=http://localhost:8000
# Public URL of the MANOVIK app itself (used in auth redirect links).
APP_PUBLIC_URL=http://localhost:3000

# --- GoTrue (auth) options ---
# Set to true to close public registration.
GOTRUE_DISABLE_SIGNUP=false
# Auto-confirm email sign-ups so no SMTP server is needed for local use.
# For production set this to false and configure SMTP below.
GOTRUE_MAILER_AUTOCONFIRM=true
# SMTP (only needed when GOTRUE_MAILER_AUTOCONFIRM=false):
#GOTRUE_SMTP_HOST=
#GOTRUE_SMTP_PORT=587
#GOTRUE_SMTP_USER=
#GOTRUE_SMTP_PASS=
#GOTRUE_SMTP_ADMIN_EMAIL=
#GOTRUE_SMTP_SENDER_NAME=MANOVIK

# Google OAuth (optional — the login page offers Google sign-in).
# Register this redirect URI in Google Cloud Console:
#   <SUPABASE_PUBLIC_URL>/auth/v1/callback   (e.g. http://localhost:8000/auth/v1/callback)
#GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
#GOTRUE_EXTERNAL_GOOGLE_SECRET=
